{
  "listen_addr": "127.0.0.1:18092",
  "relay_url": "http://127.0.0.1:18080",
  "state_dir": "./state-bilibili-connector",
  "account_id": "bilibili-ego",
  "self_mids": [],
  "dry_run": true,
  "poll_interval_sec": 30,
  "max_initial_age_sec": 300,
  "ego": {
    "task_space": "jinx-bilibili-comments",
    "timeout_sec": 45,
    "keep_page": false
  },
  "targets": [
    {
      "container_id": "bilibili:BV1example0001",
      "label": "Example Creator Video",
      "bvid": "BV1example0001",
      "comment_type": 1,
      "enabled": true,
      "poll_limit": 20,
      "sort_mode": "time",
      "sub_reply_limit": 5
    }
  ],
  "registry": {
    "url": "http://127.0.0.1:18088",
    "token_file": "./connector-registry.token",
    "heartbeat_interval_sec": 10,
    "heartbeat_ttl_sec": 35
  }
}
